<!--
  Spacing tokens on the 4 epx grid. The same values live in Space (UI/Grid.cs) for code.
  Views use these keys, never raw numbers. tools/grid-lint.ps1 skips this file.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">36</x:Double>
    <x:Double x:Key="SpaceSection">48</x:Double>

    <!-- Pages: 36 epx on the sides, like Windows Settings and the WinUI Gallery. -->
    <Thickness x:Key="PageMargin">36,24,36,36</Thickness>
    <!-- The gap between a page title and its content. -->
    <Thickness x:Key="PageHeaderMargin">0,0,0,24</Thickness>
    <!-- A group header above a stack of cards: 32 above, 8 below. -->
    <Thickness x:Key="GroupHeaderMargin">0,32,0,8</Thickness>
    <!-- Cards pad 16. -->
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- Fixed column widths. -->
    <!-- GridLength, not Double: ColumnDefinition.Width only takes a GridLength. -->
    <GridLength x:Key="ListColumnWidth">320</GridLength>
    <x:Double x:Key="ContentMaxWidth">1000</x:Double>
    <x:Double x:Key="EmptyStateGlyphSize">48</x:Double>
</ResourceDictionary>
