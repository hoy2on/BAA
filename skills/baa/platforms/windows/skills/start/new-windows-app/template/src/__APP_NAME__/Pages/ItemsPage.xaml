<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="__APP_NAME__.Pages.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:__APP_NAME__.Core"
    xmlns:ui="using:__APP_NAME__.UI"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- One card look for the list and the detail. Theme brushes only: they follow light, dark, and high contrast. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="{StaticResource PageMargin}"
        ui:GridArea.Name="page"
        ui:GridArea.Inset="{StaticResource SpaceXxl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: the page title on the left, the page's commands on the right. -->
        <!-- The probe sits on the header row, not the title: the title is centered against
             the taller command bar, so its own bottom edge is not a grid line. -->
        <Grid
            Margin="{StaticResource PageHeaderMargin}"
            ui:GridProbe.Area="page"
            ui:GridProbe.Name="header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}" />
            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <AppBarButton x:Name="NewButton" Click="OnNew" Icon="Add" Label="New item">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="StarButton" Click="OnStar" Label="Star">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Click="OnDelete" Icon="Delete" Label="Delete" KeyboardAcceleratorTextOverride="Delete" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource SpaceLg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ListColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" ui:GridProbe.Area="page" ui:GridProbe.Name="list">
                <Grid>
                    <ListView
                        x:Name="List"
                        Padding="0,4"
                        ItemsSource="{x:Bind Model.Visible}"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Single">
                        <ListView.KeyboardAccelerators>
                            <!-- Delete only while the list has focus, so it never fires in a text box. -->
                            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteKey" ScopeOwner="{x:Bind List}" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Item">
                                <Grid ColumnSpacing="{StaticResource SpaceMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnStarRow" Tag="{x:Bind}" Text="Star or unstar">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE734;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="OnDeleteRow" Icon="Delete" Tag="{x:Bind}" Text="Delete" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind DisplayTitle, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state: what the page is for, and the first action. -->
                    <StackPanel
                        x:Name="EmptyList"
                        Padding="{StaticResource CardPadding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceSm}">
                        <FontIcon
                            x:Name="EmptyGlyph"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource EmptyStateGlyphSize}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            x:Name="EmptyTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Press Ctrl+N to add one."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Click="OnNew"
                            Content="New item"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="{StaticResource CardPadding}"
                Style="{StaticResource CardStyle}"
                ui:GridProbe.Area="page"
                ui:GridProbe.Edge="">
                <Grid>
                    <StackPanel x:Name="Detail" Spacing="{StaticResource SpaceLg}">
                        <TextBox
                            x:Name="TitleBox"
                            Header="Title"
                            PlaceholderText="Untitled"
                            Text="{x:Bind Model.Selection.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                        <ToggleSwitch Header="Starred" IsOn="{x:Bind Model.Selection.IsStarred, Mode=TwoWay, FallbackValue=False}" />
                        <TextBox
                            MinHeight="120"
                            AcceptsReturn="True"
                            Header="Notes"
                            Text="{x:Bind Model.Selection.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        x:Name="NoSelection"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceSm}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource EmptyStateGlyphSize}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No selection" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select an item to see its details." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
