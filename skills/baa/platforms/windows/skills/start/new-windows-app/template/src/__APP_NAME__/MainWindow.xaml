<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="__APP_NAME__.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="__APP_NAME__">

    <!-- Mica: the window picks up the desktop tint, like Windows' own apps. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar holds the pane toggle, as in Windows 11's own apps. -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="__APP_NAME__"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationChanged">
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- APP_GRID=1 draws the grid and the layout probes here. -->
        <Canvas x:Name="GridCanvas" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
</Window>
